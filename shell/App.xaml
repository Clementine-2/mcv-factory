<Application x:Class="ProjectFactory.Workbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xml:lang="zh-CN">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Unknown" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>

      <!-- CJK-first stack. Segoe UI Variable is Latin-first and font-links to Japanese
           glyphs on many machines, which shows up as 异体 / condensed CJK. -->
      <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI, Microsoft YaHei</FontFamily>
      <FontFamily x:Key="AppDisplayFont">Microsoft YaHei UI, Segoe UI Variable Display, Segoe UI, Microsoft YaHei</FontFamily>

      <sys:Double x:Key="AppFontSizeEyebrow">12</sys:Double>
      <sys:Double x:Key="AppFontSizeBody">14</sys:Double>
      <sys:Double x:Key="AppFontSizeLead">15</sys:Double>
      <sys:Double x:Key="AppFontSizeSection">19</sys:Double>
      <sys:Double x:Key="AppFontSizeTitle">34</sys:Double>

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontStretch" Value="Normal" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
      </Style>
      <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontStretch" Value="Normal" />
      </Style>
      <Style x:Key="PageEyebrow" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeEyebrow}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="PageLead" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeLead}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="23" />
      </Style>
      <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeEyebrow}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>
      <Style x:Key="PlainValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
      </Style>

      <!-- D2: harmonize native WPF ListBox/TreeView with the Fluent card surface.
           Keyed (not implicit TargetType) on purpose: an implicit ListBox style would
           also restyle WPF-UI's internal NavigationView ListBox and break the nav pane. -->
      <Style x:Key="FluentListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      </Style>
      <Style x:Key="FluentTreeView" TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="4" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
