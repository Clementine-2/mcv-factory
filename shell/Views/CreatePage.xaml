<Page x:Class="ProjectFactory.Workbench.Views.CreatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
  <Page.Resources>
    <DataTemplate x:Key="CatalogOptionTemplate">
      <StackPanel Margin="0,4,0,8" MaxWidth="520">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Blurb}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>
  <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
    <Grid Margin="40,32,40,48" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="26" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="新建项目" Style="{StaticResource PageEyebrow}" />
        <TextBlock x:Name="CreateTitle" Text="先选一套蓝图，或自己写想法。" Style="{StaticResource PageTitle}" Margin="0,9,0,9" />
        <TextBlock x:Name="CreateLead" Text="推荐蓝图是完整开工规格，不是一句白话。AI优化只改描述；规则整理用本机规则；下一步进入确认。" Style="{StaticResource PageLead}" />

        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Step1Badge" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentFillColorDefaultBrush}"><TextBlock x:Name="Step1Text" Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
            <TextBlock Text="描述" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="—" Opacity="0.35" Margin="15,0" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Step2Badge" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource ControlFillColorDefaultBrush}"><TextBlock x:Name="Step2Text" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
            <TextBlock Text="确认理解" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock Text="—" Opacity="0.35" Margin="15,0" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Step3Badge" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource ControlFillColorDefaultBrush}"><TextBlock x:Name="Step3Text" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
            <TextBlock Text="生成完成" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="2">
        <!-- STEP 1 -->
        <Grid x:Name="DescribePanel">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ui:Card Padding="26">
            <StackPanel>
              <TextBlock Text="你想做什么？" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="可以手写。点下面的推荐蓝图会以标签形式叠加在下方，不会改你的文字。" Style="{StaticResource PageLead}" FontSize="13" Margin="0,6,0,12" />

              <WrapPanel x:Name="SelectedChipHost" Margin="0,0,0,8" Visibility="Collapsed" />
              <TextBox x:Name="RequirementTextBox" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14" FontSize="14" SpellCheck.IsEnabled="False" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:ProgressRing x:Name="AnalyzeProgress" Width="18" Height="18" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,9,0" />
                  <TextBlock x:Name="AnalyzeStatus" Text="AI优化只改描述。规则整理用本机规则进入确认。下一步跳过整理。" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ui:Button x:Name="AiOptimizeButton" Content="AI优化" Appearance="Secondary" Padding="16,10" Margin="0,0,8,0" Click="AiAssist_Click" ToolTip="需先在下方展开“AI 服务商”并启用。只改描述，不直接生成。" />
                  <ui:Button x:Name="AnalyzeButton" Content="规则整理" Appearance="Secondary" Padding="16,10" Margin="0,0,8,0" Click="Analyze_Click" ToolTip="本机规则，不联网。只整理需求，不生成文件。" />
                  <ui:Button x:Name="SkipAnalyzeButton" Content="下一步" Appearance="Primary" Padding="20,10" Click="SkipAnalyze_Click" ToolTip="跳过整理，直接用当前蓝图和手写描述进入确认。" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="AiAssistStatus" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

              <TextBlock Text="推荐蓝图（完整开工规格，可多选叠加）" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
              <TextBlock x:Name="SelectedModulesText" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Text="还没选蓝图。点上面的推荐蓝图，或自己写一句想法。" />
              <TextBox x:Name="CatalogSearchBox" Height="34" Padding="10,6" Margin="0,0,0,8" TextChanged="CatalogSearch_TextChanged" />
              <TextBlock x:Name="SelectionConflictText" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
              <TextBlock x:Name="SelectedPreviewText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
              <WrapPanel x:Name="TemplatesHost" />

              <Expander Header="按模块拼装" Margin="0,16,0,0" IsExpanded="False">
                <StackPanel x:Name="CatalogHost" Margin="0,12,0,0" />
              </Expander>

              <Expander Header="模板导入 / 导出 / 空目录" Margin="0,10,0,0" IsExpanded="False">
                <WrapPanel Margin="0,12,0,0">
                  <ui:Button Content="导出空白模板…" Appearance="Primary" Margin="0,0,8,8" Click="ExportEmptyTemplate_Click" />
                  <ui:Button Content="导出当前蓝图…" Appearance="Secondary" Margin="0,0,8,8" Click="ExportBlueprint_Click" />
                  <ui:Button Content="导入已填模板…" Appearance="Secondary" Margin="0,0,8,8" Click="ImportBlueprint_Click" />
                  <ui:Button Content="只要空目录" Appearance="Secondary" Margin="0,0,8,8" Click="BlankProject_Click" />
                </WrapPanel>
              </Expander>

              <Expander Header="AI 服务商" Margin="0,10,0,0" IsExpanded="False">
                <StackPanel Margin="0,12,0,0">
                  <WrapPanel>
                    <CheckBox x:Name="AiEnableBox" Content="启用 AI" VerticalAlignment="Center" Margin="0,0,12,8" Checked="CreateAiChanged" Unchecked="CreateAiChanged" />
                    <ComboBox x:Name="CreateAiPresetBox" MinWidth="220" Margin="0,0,8,8" SelectionChanged="CreateAiPresetChanged" />
                    <ui:Button Content="读取本机 Ollama 模型" Appearance="Secondary" Margin="0,0,8,8" Click="LoadOllamaModels_Click" />
                    <ui:Button Content="去设置填密钥" Appearance="Secondary" Margin="0,0,8,8" Click="OpenSettings_Click" />
                  </WrapPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ui:Card>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="你不需要先决定" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="项目 Profile、脚手架工具、验证配方、Provider 版本。它们由确认后的需求矩阵和 Registry 决定。" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="AI 是可选助手" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="不开 AI 也能工作。启用后，AI 只辅助理解；最终仍要经过用户确认、Schema、Policy 和验证门。" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- STEP 2 -->
        <Grid x:Name="ReviewPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Padding="26">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="系统这样理解" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="只改你真正关心的内容。生成类型由确认后的结构重新计算。" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,5,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="12,5">
                    <TextBlock x:Name="ProfileText" Text="未匹配" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  </Border>
                </Grid>

                <TextBlock Text="项目名称" Style="{StaticResource FieldLabel}" Margin="0,22,0,6" />
                <TextBox x:Name="ProjectNameBox" Padding="10,8" />

                <TextBlock Text="项目目的" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <TextBox x:Name="PurposeBox" MinHeight="82" AcceptsReturn="True" TextWrapping="Wrap" Padding="10" />

                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="交付物类型" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="WorkProductsBox" Padding="8" MaxDropDownHeight="360" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    <TextBlock x:Name="WorkProductHint" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="必须技术 / 语言" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="RequiredTechBox" Padding="8" MaxDropDownHeight="320" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    <TextBlock x:Name="LanguageHint" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>

                <Expander Header="更多设置（可选，默认收起）" Margin="0,18,0,0" IsExpanded="False">
                  <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="模块勾选（GUI / TUI / 下载 / 协议…分开掌握）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <ScrollViewer x:Name="ModuleScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="ModuleCheckHost" />
                </ScrollViewer>
                <Border x:Name="SelectionWarningBorder" Margin="0,10,0,0" Padding="12,9" CornerRadius="8"
                        BorderThickness="1" Visibility="Collapsed">
                  <TextBlock x:Name="SelectionWarning" FontSize="12.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>

                <TextBlock Text="主体框架" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <ComboBox x:Name="BodyBox" Padding="8" MaxDropDownHeight="360" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                <TextBlock x:Name="BodyHint" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="质量要求" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <ComboBox x:Name="QualityBox" Padding="8" MaxDropDownHeight="320" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                <TextBlock x:Name="QualityHint" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="选配（默认推荐勾选；全关则只生成空目录）" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
                <WrapPanel>
                  <CheckBox x:Name="OptScaffold" Content="项目骨架" IsChecked="True" Margin="0,0,16,8" ToolTip="生成可运行的项目目录与基础文件。" />
                  <CheckBox x:Name="OptVerify" Content="自动验证" IsChecked="True" Margin="0,0,16,8" ToolTip="生成后自动跑质量与结构验证门；不通过会明确报错。" />
                  <CheckBox x:Name="OptOverlay" Content="附带技能包" IsChecked="True" Margin="0,0,16,8" ToolTip="给 AI 助手附带一份技能包，让它更懂本项目。" />
                  <CheckBox x:Name="OptHarness" Content="AI 规则文件" IsChecked="True" Margin="0,0,16,8" ToolTip="生成 AGENTS.md 等 AI 协作规则文件。" />
                  <CheckBox x:Name="OptReadme" Content="说明文档" IsChecked="True" Margin="0,0,16,8" ToolTip="生成 README 说明文档。" />
                </WrapPanel>

                <Expander Header="高级细节" Margin="0,18,0,0">
                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="偏好技术" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="PreferredTechBox" Padding="8" MaxDropDownHeight="280" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="禁止技术" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="ProhibitedTechBox" Padding="8" MaxDropDownHeight="280" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                      <TextBlock Text="目标平台" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="TargetsBox" Padding="8" MaxDropDownHeight="280" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                      <TextBlock Text="硬约束" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="HardConstraintsBox" Padding="8" MaxDropDownHeight="280" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0">
                      <TextBlock Text="生命周期" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="LifecycleBox" Padding="8" MaxDropDownHeight="240" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                      <TextBlock Text="规模提示" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="ScaleBox" Padding="8" MaxDropDownHeight="240" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                  </Grid>
                </Expander>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ui:Card>

            <StackPanel Grid.Column="2">
              <ui:Card Padding="22">
                <StackPanel>
                  <TextBlock Text="还需要确认" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock x:Name="QuestionsText" Text="没有额外问题。" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="20" />
                </StackPanel>
              </ui:Card>
              <ui:Card Padding="22" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="生成位置" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock x:Name="OutputDirText" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                  <ui:Button Content="修改默认目录" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ChangeOutput_Click" />
                </StackPanel>
              </ui:Card>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <ui:Button Content="返回修改描述" Appearance="Secondary" Click="BackToDescribe_Click" Margin="0,0,8,0" />
              <ui:Button Content="导出当前蓝图…" Appearance="Secondary" Click="ExportBlueprint_Click" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <ui:ProgressRing x:Name="GenerateProgress" Width="18" Height="18" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0" />
              <ui:Button x:Name="GenerateButton" Content="确认并生成" Appearance="Primary" Padding="22,10" Click="Generate_Click" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- STEP 3 -->
        <Grid x:Name="ResultPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ui:Card Padding="30">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Width="54" Height="54" CornerRadius="27" Background="#167C3B" VerticalAlignment="Top">
                <TextBlock Text="✓" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="2">
                <TextBlock x:Name="ResultHeadline" Text="项目已生成并通过验证" FontFamily="{StaticResource AppDisplayFont}" FontSize="27" FontWeight="SemiBold" />
                <TextBlock x:Name="ResultSummary" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />

                <Grid Margin="0,26,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="Profile" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="ResultProfile" Grid.Column="1" Style="{StaticResource PlainValue}" />
                  <TextBlock Grid.Row="2" Text="项目目录" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="ResultRoot" Grid.Row="2" Grid.Column="1" Style="{StaticResource PlainValue}" />
                  <TextBlock Grid.Row="4" Text="验证 ZIP" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="ResultZip" Grid.Row="4" Grid.Column="1" Style="{StaticResource PlainValue}" />
                </Grid>
                <TextBlock Text="验证声明" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <TextBox x:Name="ResultClaims" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="180" Padding="10" FontSize="12" />

                <WrapPanel Margin="0,24,0,0">
                  <ui:Button Content="打开项目目录" Appearance="Primary" Margin="0,0,8,8" Click="OpenProject_Click" />
                  <ui:Button Content="打开 ZIP 所在目录" Appearance="Secondary" Margin="0,0,8,8" Click="OpenZip_Click" />
                  <ui:Button Content="再建一个项目" Appearance="Secondary" Margin="0,0,8,8" Click="StartAnother_Click" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </ui:Card>
          <TextBlock Grid.Row="2" Text="Factory 只把机械验证通过的结果标为 VERIFIED。项目目录和 ZIP 都保留在你选择的输出位置。" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
