<Page x:Class="ProjectFactory.Workbench.Views.CreatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
  <Page.Resources>
    <DataTemplate x:Key="CatalogOptionTemplate">
      <StackPanel Margin="0,4,0,8" MaxWidth="520">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Blurb}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>
  <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
    <Grid Margin="40,32,40,48" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="26" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="{DynamicResource Create_t29}" Style="{StaticResource PageEyebrow}" />
        <TextBlock x:Name="CreateTitle" Text="{DynamicResource Create_CreateTitle30}" Style="{StaticResource PageTitle}" Margin="0,9,0,9" />
        <TextBlock x:Name="CreateLead" Text="{DynamicResource Create_CreateLead31}" Style="{StaticResource PageLead}" />

        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Step1Badge" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentFillColorDefaultBrush}"><TextBlock x:Name="Step1Text" Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
            <TextBlock Text="{DynamicResource Create_Step1Badge32}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="—" Opacity="0.35" Margin="15,0" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Step2Badge" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource ControlFillColorDefaultBrush}"><TextBlock x:Name="Step2Text" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
            <TextBlock Text="{DynamicResource Create_Step2Badge33}" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock Text="—" Opacity="0.35" Margin="15,0" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Step3Badge" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource ControlFillColorDefaultBrush}"><TextBlock x:Name="Step3Text" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
            <TextBlock Text="{DynamicResource Create_Step3Badge34}" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="2">
        <!-- STEP 1 -->
        <Grid x:Name="DescribePanel">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ui:Card Padding="26">
            <StackPanel>
              <TextBlock Text="{DynamicResource Create_DescribePanel35}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{DynamicResource Create_DescribePanel36}" Style="{StaticResource PageLead}" FontSize="13" Margin="0,6,0,12" />

              <WrapPanel x:Name="SelectedChipHost" Margin="0,0,0,8" Visibility="Collapsed" />
              <TextBox x:Name="RequirementTextBox" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14" FontSize="14" SpellCheck.IsEnabled="False" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:ProgressRing x:Name="AnalyzeProgress" Width="18" Height="18" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,9,0" />
                  <TextBlock x:Name="AnalyzeStatus" Text="{DynamicResource Create_AnalyzeStatus37}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ui:Button x:Name="AiOptimizeButton" Content="{DynamicResource Create_AiOptimizeButton38}" Appearance="Secondary" Padding="16,10" Margin="0,0,8,0" Click="AiAssist_Click" ToolTip="{DynamicResource Create_AiOptimizeButton39}" />
                  <ui:Button x:Name="AnalyzeButton" Content="{DynamicResource Create_AnalyzeButton40}" Appearance="Secondary" Padding="16,10" Margin="0,0,8,0" Click="Analyze_Click" ToolTip="{DynamicResource Create_AnalyzeButton41}" />
                  <ui:Button x:Name="SkipAnalyzeButton" Content="{DynamicResource Create_SkipAnalyzeButton42}" Appearance="Primary" Padding="20,10" Click="SkipAnalyze_Click" ToolTip="{DynamicResource Create_SkipAnalyzeButton43}" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="AiAssistStatus" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

              <TextBlock Text="{DynamicResource Create_AiAssistStatus44}" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
              <TextBlock x:Name="SelectedModulesText" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource Create_SelectedModulesText45}" />
              <TextBox x:Name="CatalogSearchBox" Height="34" Padding="10,6" Margin="0,0,0,8" TextChanged="CatalogSearch_TextChanged" />
              <TextBlock x:Name="SelectionConflictText" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
              <TextBlock x:Name="SelectedPreviewText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
              <WrapPanel x:Name="TemplatesHost" />

              <Expander Header="{DynamicResource Create_TemplatesHost46}" Margin="0,16,0,0" IsExpanded="False">
                <StackPanel x:Name="CatalogHost" Margin="0,12,0,0" />
              </Expander>

              <Expander Header="{DynamicResource Create_CatalogHost47}" Margin="0,10,0,0" IsExpanded="False">
                <WrapPanel Margin="0,12,0,0">
                  <ui:Button Content="{DynamicResource Create_CatalogHost48}" Appearance="Primary" Margin="0,0,8,8" Click="ExportEmptyTemplate_Click" />
                  <ui:Button Content="{DynamicResource Create_CatalogHost49}" Appearance="Secondary" Margin="0,0,8,8" Click="ExportBlueprint_Click" />
                  <ui:Button Content="{DynamicResource Create_CatalogHost50}" Appearance="Secondary" Margin="0,0,8,8" Click="ImportBlueprint_Click" />
                  <ui:Button Content="{DynamicResource Create_t51}" Appearance="Secondary" Margin="0,0,8,8" Click="BlankProject_Click" />
                </WrapPanel>
              </Expander>

              <Expander Header="{DynamicResource Create_t52}" Margin="0,10,0,0" IsExpanded="False">
                <StackPanel Margin="0,12,0,0">
                  <WrapPanel>
                    <CheckBox x:Name="AiEnableBox" Content="{DynamicResource Create_AiEnableBox53}" VerticalAlignment="Center" Margin="0,0,12,8" Checked="CreateAiChanged" Unchecked="CreateAiChanged" />
                    <ComboBox x:Name="CreateAiPresetBox" MinWidth="220" Margin="0,0,8,8" SelectionChanged="CreateAiPresetChanged" />
                    <ui:Button Content="{DynamicResource Create_CreateAiPresetBox54}" Appearance="Secondary" Margin="0,0,8,8" Click="LoadOllamaModels_Click" />
                    <ui:Button Content="{DynamicResource Create_CreateAiPresetBox55}" Appearance="Secondary" Margin="0,0,8,8" Click="OpenSettings_Click" />
                  </WrapPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ui:Card>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{DynamicResource Create_t56}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Create_t57}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{DynamicResource Create_t58}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Create_t59}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- STEP 2 -->
        <Grid x:Name="ReviewPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Padding="26">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Create_t60}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Create_t61}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,5,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="12,5">
                    <TextBlock x:Name="ProfileText" Text="{DynamicResource Create_ProfileText62}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  </Border>
                </Grid>

                <TextBlock Text="{DynamicResource Create_ProfileText63}" Style="{StaticResource FieldLabel}" Margin="0,22,0,6" />
                <TextBox x:Name="ProjectNameBox" Padding="10,8" />

                <TextBlock Text="{DynamicResource Create_ProjectNameBox64}" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <TextBox x:Name="PurposeBox" MinHeight="82" AcceptsReturn="True" TextWrapping="Wrap" Padding="10" />

                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Create_PurposeBox65}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="WorkProductsBox" Padding="8" MaxDropDownHeight="360" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    <TextBlock x:Name="WorkProductHint" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Create_WorkProductHint66}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="RequiredTechBox" Padding="8" MaxDropDownHeight="320" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    <TextBlock x:Name="LanguageHint" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>

                <Expander Header="{DynamicResource Create_LanguageHint67}" Margin="0,18,0,0" IsExpanded="False">
                  <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{DynamicResource Create_LanguageHint68}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <ScrollViewer x:Name="ModuleScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="ModuleCheckHost" />
                </ScrollViewer>
                <Border x:Name="SelectionWarningBorder" Margin="0,10,0,0" Padding="12,9" CornerRadius="8"
                        BorderThickness="1" Visibility="Collapsed">
                  <TextBlock x:Name="SelectionWarning" FontSize="12.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>

                <TextBlock Text="{DynamicResource Create_SelectionWarning69}" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <ComboBox x:Name="BodyBox" Padding="8" MaxDropDownHeight="360" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                <TextBlock x:Name="BodyHint" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="{DynamicResource Create_BodyHint70}" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <ComboBox x:Name="QualityBox" Padding="8" MaxDropDownHeight="320" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                <TextBlock x:Name="QualityHint" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="{DynamicResource Create_QualityHint71}" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
                <WrapPanel>
                  <CheckBox x:Name="OptScaffold" Content="{DynamicResource Create_OptScaffold72}" IsChecked="True" Margin="0,0,16,8" ToolTip="{DynamicResource Create_OptScaffold73}" />
                  <CheckBox x:Name="OptVerify" Content="{DynamicResource Create_OptVerify74}" IsChecked="True" Margin="0,0,16,8" ToolTip="{DynamicResource Create_OptVerify75}" />
                  <CheckBox x:Name="OptOverlay" Content="{DynamicResource Create_OptOverlay76}" IsChecked="True" Margin="0,0,16,8" ToolTip="{DynamicResource Create_OptOverlay77}" />
                  <CheckBox x:Name="OptHarness" Content="{DynamicResource Create_OptHarness78}" IsChecked="True" Margin="0,0,16,8" ToolTip="{DynamicResource Create_OptHarness79}" />
                  <CheckBox x:Name="OptReadme" Content="{DynamicResource Create_OptReadme80}" IsChecked="True" Margin="0,0,16,8" ToolTip="{DynamicResource Create_OptReadme81}" />
                </WrapPanel>

                <Expander Header="{DynamicResource Create_OptReadme82}" Margin="0,18,0,0">
                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{DynamicResource Create_t83}" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="PreferredTechBox" Padding="8" MaxDropDownHeight="280" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{DynamicResource Create_PreferredTechBox84}" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="ProhibitedTechBox" Padding="8" MaxDropDownHeight="280" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                      <TextBlock Text="{DynamicResource Create_ProhibitedTechBox85}" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="TargetsBox" Padding="8" MaxDropDownHeight="280" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                      <TextBlock Text="{DynamicResource Create_TargetsBox86}" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="HardConstraintsBox" Padding="8" MaxDropDownHeight="280" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0">
                      <TextBlock Text="{DynamicResource Create_HardConstraintsBox87}" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="LifecycleBox" Padding="8" MaxDropDownHeight="240" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                      <TextBlock Text="{DynamicResource Create_LifecycleBox88}" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="ScaleBox" Padding="8" MaxDropDownHeight="240" ItemTemplate="{StaticResource CatalogOptionTemplate}" SelectionChanged="ExplainedComboChanged" />
                    </StackPanel>
                  </Grid>
                </Expander>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ui:Card>

            <StackPanel Grid.Column="2">
              <ui:Card Padding="22">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Create_t89}" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock x:Name="QuestionsText" Text="{DynamicResource Create_QuestionsText90}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="20" />
                </StackPanel>
              </ui:Card>
              <ui:Card Padding="22" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Create_QuestionsText91}" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock x:Name="OutputDirText" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                  <ui:Button Content="{DynamicResource Create_OutputDirText92}" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ChangeOutput_Click" />
                </StackPanel>
              </ui:Card>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <ui:Button Content="{DynamicResource Create_t93}" Appearance="Secondary" Click="BackToDescribe_Click" Margin="0,0,8,0" />
              <ui:Button Content="{DynamicResource Create_CatalogHost49}" Appearance="Secondary" Click="ExportBlueprint_Click" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <ui:ProgressRing x:Name="GenerateProgress" Width="18" Height="18" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0" />
              <ui:Button x:Name="GenerateButton" Content="{DynamicResource Create_GenerateButton94}" Appearance="Primary" Padding="22,10" Click="Generate_Click" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- STEP 3 -->
        <Grid x:Name="ResultPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ui:Card Padding="30">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Width="54" Height="54" CornerRadius="27" Background="#167C3B" VerticalAlignment="Top">
                <TextBlock Text="{DynamicResource Create_ResultPanel95}" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="2">
                <TextBlock x:Name="ResultHeadline" Text="{DynamicResource Create_ResultHeadline96}" FontFamily="{StaticResource AppDisplayFont}" FontSize="27" FontWeight="SemiBold" />
                <TextBlock x:Name="ResultSummary" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />

                <Grid Margin="0,26,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource Create_ResultSummary97}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="ResultProfile" Grid.Column="1" Style="{StaticResource PlainValue}" />
                  <TextBlock Grid.Row="2" Text="{DynamicResource Create_ResultProfile98}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="ResultRoot" Grid.Row="2" Grid.Column="1" Style="{StaticResource PlainValue}" />
                  <TextBlock Grid.Row="4" Text="{DynamicResource Create_ResultRoot99}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="ResultZip" Grid.Row="4" Grid.Column="1" Style="{StaticResource PlainValue}" />
                </Grid>
                <TextBlock Text="{DynamicResource Create_ResultZip100}" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <TextBox x:Name="ResultClaims" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="180" Padding="10" FontSize="12" />

                <WrapPanel Margin="0,24,0,0">
                  <ui:Button Content="{DynamicResource Create_ResultClaims101}" Appearance="Primary" Margin="0,0,8,8" Click="OpenProject_Click" />
                  <ui:Button Content="{DynamicResource Create_ResultClaims102}" Appearance="Secondary" Margin="0,0,8,8" Click="OpenZip_Click" />
                  <ui:Button Content="{DynamicResource Create_ResultClaims103}" Appearance="Secondary" Margin="0,0,8,8" Click="StartAnother_Click" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </ui:Card>
          <TextBlock Grid.Row="2" Text="{DynamicResource Create_t104}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
