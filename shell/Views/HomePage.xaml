<Page x:Class="ProjectFactory.Workbench.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
  <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
    <Grid Margin="40,32,40,48" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="34" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="30" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="{DynamicResource Home_t7}" Style="{StaticResource PageEyebrow}" />
        <TextBlock Text="{DynamicResource Home_t8}" Style="{StaticResource PageTitle}" Margin="0,10,0,10" />
        <TextBlock Text="{DynamicResource Home_t9}" Style="{StaticResource PageLead}" />
        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
          <ui:Button Content="{DynamicResource Home_t10}" Appearance="Primary" Padding="20,11" Click="Create_Click" />
          <ui:Button Content="{DynamicResource Home_t11}" Appearance="Secondary" Padding="20,11" Margin="10,0,0,0" Click="Projects_Click" />
          <ui:Button Content="{DynamicResource Home_t12}" Appearance="Secondary" Padding="20,11" Margin="10,0,0,0" Click="Resources_Click" />
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.55*" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <ui:Card Grid.Column="0" Padding="24" MinHeight="150" VerticalAlignment="Stretch">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource Home_t13}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Home_t14}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0" />
              </StackPanel>
              <ui:ProgressRing x:Name="StatusProgress" Grid.Column="1" Width="20" Height="20" IsIndeterminate="True" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,22,0,0">
              <TextBlock x:Name="StatusHeadline" Text="{DynamicResource Home_StatusHeadline15}" FontFamily="{StaticResource AppDisplayFont}" FontSize="25" FontWeight="SemiBold" />
              <TextBlock x:Name="StatusDetail" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20" />
              <ui:Button x:Name="StatusActionButton" Content="{DynamicResource Home_StatusActionButton16}" Appearance="Secondary" Margin="0,14,0,0" Visibility="Collapsed" Click="StatusAction_Click" />
            </StackPanel>
          </Grid>
        </ui:Card>

        <ui:Card Grid.Column="2" Padding="24" MinHeight="150" VerticalAlignment="Stretch">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Home_t17}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ui:Button x:Name="ToggleProfilesButton" Grid.Column="1" Content="{DynamicResource Home_ToggleProfilesButton18}" Appearance="Secondary" Padding="10,4" FontSize="11" Click="ToggleProfiles_Click" Visibility="Collapsed"/>
          </Grid>
          <TextBlock x:Name="ReadyProfiles" Grid.Row="1" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,6" TextWrapping="Wrap" LineHeight="22" MaxHeight="48" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="ReadyProfilesHint" Grid.Row="2" Text="{DynamicResource Home_ReadyProfilesHint19}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" LineHeight="18" />
          </Grid>
        </ui:Card>
      </Grid>

      <StackPanel Grid.Row="4">
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource Home_t20}" Style="{StaticResource SectionTitle}" />
          <ui:Button Grid.Column="1" Content="{DynamicResource Home_t21}" Appearance="Secondary" Click="Projects_Click" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ui:Card Grid.Column="0" Padding="20">
            <StackPanel>
              <TextBlock Text="{DynamicResource Home_t22}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Home_t23}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
              <ui:Button Content="{DynamicResource Home_t24}" Appearance="Secondary" Margin="0,18,0,0" HorizontalAlignment="Left" Tag="python-cli" Click="Template_Click" />
            </StackPanel>
          </ui:Card>
          <ui:Card Grid.Column="2" Padding="20">
            <StackPanel>
              <TextBlock Text="{DynamicResource Home_t25}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Home_t26}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
              <ui:Button Content="{DynamicResource Home_t24}" Appearance="Secondary" Margin="0,18,0,0" HorizontalAlignment="Left" Tag="python-library" Click="Template_Click" />
            </StackPanel>
          </ui:Card>
          <ui:Card Grid.Column="4" Padding="20">
            <StackPanel>
              <TextBlock Text="{DynamicResource Home_t27}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Home_t28}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
              <ui:Button Content="{DynamicResource Home_t24}" Appearance="Secondary" Margin="0,18,0,0" HorizontalAlignment="Left" Tag="browser-extension" Click="Template_Click" />
            </StackPanel>
          </ui:Card>
        </Grid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
