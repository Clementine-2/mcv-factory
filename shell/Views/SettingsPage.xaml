<Page x:Class="ProjectFactory.Workbench.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
  <ScrollViewer x:Name="RootScroll"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                PanningMode="VerticalOnly"
                ClipToBounds="True">
    <Grid Margin="40,32,40,48" MaxWidth="820" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="{DynamicResource Settings_t164}" Style="{StaticResource PageEyebrow}" />
        <TextBlock Text="{DynamicResource Settings_t165}" Style="{StaticResource PageTitle}" Margin="0,9,0,8" />
        <TextBlock Text="{DynamicResource Settings_t166}" Style="{StaticResource PageLead}" />
      </StackPanel>

      <ui:Card Grid.Row="2" Padding="24" ClipToBounds="True">
        <StackPanel>
          <TextBlock Text="{DynamicResource Settings_t167}" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Settings_t168}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
              <TextBlock Text="{DynamicResource Settings_t169}" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="ThemeBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="{DynamicResource Settings_ThemeBox170}" Tag="System" />
                <ComboBoxItem Content="{DynamicResource Settings_ThemeBox171}" Tag="Light" />
                <ComboBoxItem Content="{DynamicResource Settings_ThemeBox172}" Tag="Dark" />
                <ComboBoxItem Content="{DynamicResource Settings_ThemeBox173}" Tag="Midnight" />
                <ComboBoxItem Content="{DynamicResource Settings_ThemeBox174}" Tag="Warm" />
                <ComboBoxItem Content="{DynamicResource Settings_ThemeBox175}" Tag="Contrast" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{DynamicResource Settings_t176}" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="AccentBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="{DynamicResource Settings_AccentBox177}" Tag="Default" />
                <ComboBoxItem Content="{DynamicResource Settings_AccentBox178}" Tag="Blue" />
                <ComboBoxItem Content="{DynamicResource Settings_AccentBox179}" Tag="Teal" />
                <ComboBoxItem Content="{DynamicResource Settings_AccentBox180}" Tag="Green" />
                <ComboBoxItem Content="{DynamicResource Settings_AccentBox181}" Tag="Purple" />
                <ComboBoxItem Content="{DynamicResource Settings_AccentBox182}" Tag="Orange" />
                <ComboBoxItem Content="{DynamicResource Settings_AccentBox183}" Tag="Red" />
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2">
              <TextBlock Text="{DynamicResource Settings_t184}" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="BackdropBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="{DynamicResource Settings_BackdropBox185}" Tag="Mica" />
                <ComboBoxItem Content="{DynamicResource Settings_BackdropBox186}" Tag="Acrylic" />
                <ComboBoxItem Content="{DynamicResource Settings_BackdropBox187}" Tag="Tabbed" />
                <ComboBoxItem Content="{DynamicResource Settings_BackdropBox188}" Tag="None" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
              <TextBlock Text="{DynamicResource Settings_t189}" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="CornerBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="{DynamicResource Settings_CornerBox190}" Tag="Round" />
                <ComboBoxItem Content="{DynamicResource Settings_CornerBox191}" Tag="Small" />
                <ComboBoxItem Content="{DynamicResource Settings_CornerBox192}" Tag="Square" />
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="4">
              <TextBlock Text="{DynamicResource Settings_t193}" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="FontBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="{DynamicResource Settings_FontBox194}" Tag="Microsoft YaHei UI" />
                <ComboBoxItem Content="{DynamicResource Settings_FontBox195}" Tag="Microsoft YaHei" />
                <ComboBoxItem Content="{DynamicResource Settings_FontBox196}" Tag="Segoe UI" />
                <ComboBoxItem Content="{DynamicResource Settings_FontBox197}" Tag="Segoe UI Variable Text" />
                <ComboBoxItem Content="{DynamicResource Settings_FontBox198}" Tag="DengXian" />
                <ComboBoxItem Content="{DynamicResource Settings_FontBox199}" Tag="SimHei" />
                <ComboBoxItem Content="{DynamicResource Settings_FontBox200}" Tag="SimSun" />
                <ComboBoxItem Content="{DynamicResource Settings_t201}" Tag="KaiTi" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2">
              <TextBlock Text="{DynamicResource Settings_t202}" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="FontSizeBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="{DynamicResource Settings_FontSizeBox203}" Tag="Small" />
                <ComboBoxItem Content="{DynamicResource Settings_FontSizeBox204}" Tag="Default" />
                <ComboBoxItem Content="{DynamicResource Settings_FontSizeBox205}" Tag="Large" />
                <ComboBoxItem Content="{DynamicResource Settings_FontSizeBox206}" Tag="XLarge" />
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
              <TextBlock Text="{DynamicResource Settings_Language}" Style="{StaticResource FieldLabel}" />
              <TextBlock Text="{DynamicResource Settings_LanguageHint}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
              <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged">
                <ComboBoxItem Content="{DynamicResource Lang_zhCN}" Tag="zh-CN" />
                <ComboBoxItem Content="{DynamicResource Lang_zhHant}" Tag="zh-Hant" />
                <ComboBoxItem Content="{DynamicResource Lang_en}" Tag="en-US" />
              </ComboBox>
            </StackPanel>

          </Grid>

          <StackPanel Margin="0,22,0,0">
            <TextBlock Text="{DynamicResource Settings_t207}" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="BackgroundPathText" Text="{DynamicResource Settings_BackgroundPathText208}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,10,0,0">
              <ComboBox x:Name="BackgroundOpacityBox" MinWidth="110" Margin="0,0,8,8" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="{DynamicResource Settings_BackgroundOpacityBox209}" Tag="Low" />
                <ComboBoxItem Content="{DynamicResource Settings_BackgroundOpacityBox210}" Tag="Medium" />
                <ComboBoxItem Content="{DynamicResource Settings_BackgroundOpacityBox211}" Tag="High" />
              </ComboBox>
              <ui:Button Content="{DynamicResource Settings_BackgroundOpacityBox212}" Appearance="Secondary" Click="ChooseBackground_Click" Margin="0,0,8,8" />
              <ui:Button Content="{DynamicResource Settings_BackgroundOpacityBox213}" Appearance="Secondary" Click="ClearBackground_Click" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </ui:Card>

      <ui:Card Grid.Row="4" Padding="24">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,28,0">
            <TextBlock Text="{DynamicResource Settings_t214}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="OutputDirectoryText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="{DynamicResource Settings_OutputDirectoryText215}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
          </StackPanel>
          <ui:Button Grid.Column="1" Content="{DynamicResource Settings_OutputDirectoryText216}" Appearance="Secondary" VerticalAlignment="Center" Click="ChangeOutput_Click" />
        </Grid>
      </ui:Card>

      <ui:Card Grid.Row="6" Padding="24">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,28,0">
              <TextBlock Text="{DynamicResource Settings_t217}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Settings_t218}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
            <CheckBox x:Name="AiEnabledBox" Grid.Column="1" Content="{DynamicResource Settings_AiEnabledBox219}" VerticalAlignment="Center" Checked="AiChanged" Unchecked="AiChanged" />
          </Grid>

          <Grid x:Name="AiDetails" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{DynamicResource Settings_AiDetails220}" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="AiPresetBox" SelectionChanged="AiPresetChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{DynamicResource Settings_AiPresetBox221}" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="AiModelBox" IsEditable="True" Padding="8" LostFocus="AiField_LostFocus" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
              <TextBlock Text="{DynamicResource Settings_AiModelBox222}" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="AiEndpointBox" Padding="10,8" LostFocus="AiField_LostFocus" />
              <TextBlock Text="{DynamicResource Settings_AiEndpointBox223}" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
              <TextBox x:Name="AiKeyEnvBox" Padding="10,8" MaxWidth="360" HorizontalAlignment="Left" LostFocus="AiField_LostFocus" />
              <WrapPanel Margin="0,12,0,0">
                <ui:Button Content="{DynamicResource Settings_AiKeyEnvBox224}" Appearance="Secondary" Click="AiProbe_Click" Margin="0,0,8,8" />
                <ui:Button Content="{DynamicResource Settings_AiKeyEnvBox225}" Appearance="Secondary" Click="LoadOllamaModels_Click" Margin="0,0,8,8" />
                <TextBlock x:Name="AiProbeText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </WrapPanel>
              <TextBlock Text="{DynamicResource Settings_AiProbeText226}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ui:Card>
    </Grid>
  </ScrollViewer>
</Page>
