<Page x:Class="ProjectFactory.Workbench.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
  <ScrollViewer x:Name="RootScroll"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                PanningMode="VerticalOnly"
                ClipToBounds="True">
    <Grid Margin="40,32,40,48" MaxWidth="820" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="28"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="设置" Style="{StaticResource PageEyebrow}" />
        <TextBlock Text="按你的习惯工作。" Style="{StaticResource PageTitle}" Margin="0,9,0,8" />
        <TextBlock Text="这里只放长期偏好。工程内部参数仍由需求确认和 Core 门禁控制。" Style="{StaticResource PageLead}" />
      </StackPanel>

      <ui:Card Grid.Row="2" Padding="24" ClipToBounds="True">
        <StackPanel>
          <TextBlock Text="外观" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="主题、字体、字号和背景都可以改。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
              <TextBlock Text="主题" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="ThemeBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="跟随系统" Tag="System" />
                <ComboBoxItem Content="浅色" Tag="Light" />
                <ComboBoxItem Content="深色" Tag="Dark" />
                <ComboBoxItem Content="午夜" Tag="Midnight" />
                <ComboBoxItem Content="暖阳" Tag="Warm" />
                <ComboBoxItem Content="高对比" Tag="Contrast" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="强调色" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="AccentBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="跟随主题" Tag="Default" />
                <ComboBoxItem Content="蓝" Tag="Blue" />
                <ComboBoxItem Content="青绿" Tag="Teal" />
                <ComboBoxItem Content="绿" Tag="Green" />
                <ComboBoxItem Content="紫" Tag="Purple" />
                <ComboBoxItem Content="橙" Tag="Orange" />
                <ComboBoxItem Content="红" Tag="Red" />
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2">
              <TextBlock Text="窗口材质" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="BackdropBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="Mica" Tag="Mica" />
                <ComboBoxItem Content="亚克力" Tag="Acrylic" />
                <ComboBoxItem Content="Tabbed" Tag="Tabbed" />
                <ComboBoxItem Content="纯色" Tag="None" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
              <TextBlock Text="窗口圆角" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="CornerBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="圆角" Tag="Round" />
                <ComboBoxItem Content="小圆角" Tag="Small" />
                <ComboBoxItem Content="直角" Tag="Square" />
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="4">
              <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="FontBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="微软雅黑 UI（推荐）" Tag="Microsoft YaHei UI" />
                <ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei" />
                <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
                <ComboBoxItem Content="Segoe UI Variable" Tag="Segoe UI Variable Text" />
                <ComboBoxItem Content="等线" Tag="DengXian" />
                <ComboBoxItem Content="黑体" Tag="SimHei" />
                <ComboBoxItem Content="宋体" Tag="SimSun" />
                <ComboBoxItem Content="楷体" Tag="KaiTi" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2">
              <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="FontSizeBox" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="较小" Tag="Small" />
                <ComboBoxItem Content="默认" Tag="Default" />
                <ComboBoxItem Content="较大" Tag="Large" />
                <ComboBoxItem Content="更大" Tag="XLarge" />
              </ComboBox>
            </StackPanel>

          </Grid>

          <StackPanel Margin="0,22,0,0">
            <TextBlock Text="自定义背景图" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="BackgroundPathText" Text="未选择" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,10,0,0">
              <ComboBox x:Name="BackgroundOpacityBox" MinWidth="110" Margin="0,0,8,8" SelectionChanged="AppearanceChanged">
                <ComboBoxItem Content="淡" Tag="Low" />
                <ComboBoxItem Content="中" Tag="Medium" />
                <ComboBoxItem Content="浓" Tag="High" />
              </ComboBox>
              <ui:Button Content="选择…" Appearance="Secondary" Click="ChooseBackground_Click" Margin="0,0,8,8" />
              <ui:Button Content="清除" Appearance="Secondary" Click="ClearBackground_Click" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </ui:Card>

      <ui:Card Grid.Row="4" Padding="24">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,28,0">
            <TextBlock Text="默认项目目录" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="OutputDirectoryText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="项目资产与程序安装目录分离；卸载 Project Factory 不会碰这里。" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
          </StackPanel>
          <ui:Button Grid.Column="1" Content="更改…" Appearance="Secondary" VerticalAlignment="Center" Click="ChangeOutput_Click" />
        </Grid>
      </ui:Card>

      <ui:Card Grid.Row="6" Padding="24">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,28,0">
              <TextBlock Text="AI 需求助手" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="可选。AI 只辅助理解自然语言，不直接拥有生成权；关闭后 Factory 仍能完整工作。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
            <CheckBox x:Name="AiEnabledBox" Grid.Column="1" Content="启用" VerticalAlignment="Center" Checked="AiChanged" Unchecked="AiChanged" />
          </Grid>

          <Grid x:Name="AiDetails" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="服务商预设" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="AiPresetBox" SelectionChanged="AiPresetChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
              <ComboBox x:Name="AiModelBox" IsEditable="True" Padding="8" LostFocus="AiField_LostFocus" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
              <TextBlock Text="OpenAI 兼容端点" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="AiEndpointBox" Padding="10,8" LostFocus="AiField_LostFocus" />
              <TextBlock Text="API key 环境变量" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
              <TextBox x:Name="AiKeyEnvBox" Padding="10,8" MaxWidth="360" HorizontalAlignment="Left" LostFocus="AiField_LostFocus" />
              <WrapPanel Margin="0,12,0,0">
                <ui:Button Content="测试连通" Appearance="Secondary" Click="AiProbe_Click" Margin="0,0,8,8" />
                <ui:Button Content="读取本机 Ollama 模型" Appearance="Secondary" Click="LoadOllamaModels_Click" Margin="0,0,8,8" />
                <TextBlock x:Name="AiProbeText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </WrapPanel>
              <TextBlock Text="只保存环境变量名，不保存 key。Ollama 不写死 llama3.1：只读取本机已经 ollama pull 过的模型，不会替你下载。默认推荐 SpaceXAI（api.x.ai）。AI 只整理需求，生成权在你确认和验证门。" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ui:Card>
    </Grid>
  </ScrollViewer>
</Page>
