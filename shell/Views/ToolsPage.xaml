<Page x:Class="ProjectFactory.Workbench.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
  <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
    <Grid Margin="40,32,40,48" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="{DynamicResource Tools_RootScroll110}" Style="{StaticResource PageEyebrow}" />
        <TextBlock Text="{DynamicResource Tools_RootScroll111}" Style="{StaticResource PageTitle}" Margin="0,9,0,8" />
        <TextBlock Text="{DynamicResource Tools_RootScroll112}" Style="{StaticResource PageLead}" />
      </StackPanel>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ui:Card Grid.Column="0" Padding="24">
          <StackPanel>
            <TextBlock Text="{DynamicResource Tools_t113}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Tools_t114}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />
            <ui:Button Content="{DynamicResource Tools_t115}" Appearance="Primary" HorizontalAlignment="Left" Click="CheckProject_Click" />
          </StackPanel>
        </ui:Card>
        <ui:Card Grid.Column="2" Padding="24">
          <StackPanel>
            <TextBlock Text="{DynamicResource Tools_t116}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Tools_t117}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />
            <ui:Button Content="{DynamicResource Tools_t118}" Appearance="Primary" HorizontalAlignment="Left" Click="VerifyZip_Click" />
          </StackPanel>
        </ui:Card>
      </Grid>

      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ui:Card Grid.Column="0" Padding="24">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource Tools_t119}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Tools_t120}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,5,0,0" />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="{DynamicResource Tools_t121}" Appearance="Secondary" Click="RefreshStatus_Click" />
            </Grid>
            <ui:ProgressRing x:Name="ToolProgress" Width="20" Height="20" IsIndeterminate="True" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,18,0,0" />
            <TextBox x:Name="ToolOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="190" MaxHeight="330" Margin="0,18,0,0" Padding="12" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" />
          </StackPanel>
        </ui:Card>
        <ui:Card Grid.Column="2" Padding="24">
          <StackPanel>
            <TextBlock Text="{DynamicResource Tools_ToolOutput122}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Tools_ToolOutput123}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />
            <ui:Button Content="{DynamicResource Tools_ToolOutput124}" Appearance="Secondary" HorizontalAlignment="Left" Click="OpenLogs_Click" />
            <TextBlock Text="{DynamicResource Tools_t125}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="18" />
          </StackPanel>
        </ui:Card>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
